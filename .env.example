# Example only. No secrets belong in frontend VITE_* variables.
# The Go process reads environment variables; it does not load this file.
PORT=8080
HOST=localhost
APP_ENV=development
# Optional locally; required for readiness and the authenticated vault/media API.
# Supply your connection string through the process environment, never commit it.
# RDS must use sslmode=verify-full with the trusted AWS RDS CA certificate.
DATABASE_URL=
# Demo-only API access credential, separate from the vault passphrase.
# Supply 32-256 high-entropy printable ASCII characters without spaces.
# Never put this in VITE_* variables or a frontend bundle. Empty disables /api.
DEMO_API_TOKEN=
# Configure together to enable S3. Use a private, non-versioned lab bucket.
# Bucket names for this MVP use lowercase letters, digits, and hyphens (no dots).
# On EC2 attach the least-privilege instance role; do not add AWS keys here.
S3_BUCKET=
AWS_REGION=
# Deployment only: valid DNS hostname and certificate contact email.
DOMAIN=
ACME_EMAIL=
# Host path to the official public RDS CA bundle, mounted read-only by Compose.
# The production DATABASE_URL uses sslrootcert=/etc/ssl/certs/aws-rds-ca.pem.
RDS_CA_BUNDLE=
